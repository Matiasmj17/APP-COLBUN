.encuesta-scroll { position: absolute; left: 0; right: 0; top: 0; bottom: 190px; padding-top: 60px; }
.encuesta-margen { margin: 6px 50px 14px 50px; }
.chips { flex-direction: row; flex-wrap: wrap; margin-top: 16px; }
.chip {
    font-size: 32px; color: #0F172A; background-color: #EEF2F7;
    border-width: 0; border-radius: 40px;
    padding: 16px 30px; margin: 6px 12px 6px 0;
}
.chip--sel { background-color: #0A5CAD; color: #FFFFFF; -unity-font-style: bold; }
.encuesta-texto { margin-top: 16px; min-height: 180px; }
.encuesta-enviar { align-self: center; margin: 30px 0 60px 0; }