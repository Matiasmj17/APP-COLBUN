<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Pasaporte.uss?fileID=7433441132597879392&amp;guid=4648f424299df124ab91f243db2587d5&amp;type=3#Pasaporte"/>
    <Style src="project://database/Assets/UI/Encuesta.uss?fileID=7433441132597879392&amp;guid=b12c97bfe3a89a542b5696ccc136c3b8&amp;type=3#Encuesta"/>
    <ui:VisualElement name="pantalla-pasaporte" class="pantalla pasaporte">
        <ui:VisualElement class="cabecera">
            <ui:VisualElement class="logo-colbun-header"/>
            <ui:VisualElement class="cabecera__derecha">
                <ui:Button class="btn-icono icono-info"/>
                <ui:Button class="btn-icono icono-perfil"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="lista" mode="Vertical" vertical-scroller-visibility="Hidden" touch-scroll-type="Elastic" class="lista">
            <ui:VisualElement class="tarjeta">
                <ui:VisualElement class="fila fila--entre">
                    <ui:VisualElement>
                        <ui:Label text="RECORRIDO ACTIVO" class="texto-chico texto-azul"/>
                        <ui:Label text="Pasaporte Digital" class="titulo-grande"/>
                        <ui:Label text="Sendero Botánico • Colbún" class="texto-gris"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="logo-colbun-secundario"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="tarjeta">
                <ui:VisualElement class="fila fila--entre">
                    <ui:VisualElement class="fila">
                        <ui:VisualElement class="icono-trofeo"/>
                        <ui:Label name="lbl-progreso" text="2 de 5 estaciones" class="texto-fuerte"/>
                    </ui:VisualElement>
                    <ui:Label text="Nivel: Explorador Maule" class="pildora pildora--verde"/>
                </ui:VisualElement>
                <ui:VisualElement class="fila fila--entre margen-arriba">
                    <ui:Label text="Progreso del Sendero" class="texto-gris"/>
                    <ui:Label name="lbl-porcentaje" text="40% completado" class="texto-azul texto-negrita"/>
                </ui:VisualElement>
                <ui:VisualElement class="barra">
                    <ui:VisualElement name="barra-relleno" class="barra__relleno"/>
                </ui:VisualElement>
                <ui:VisualElement class="fila fila--entre margen-arriba">
                    <ui:VisualElement class="fila">
                        <ui:VisualElement class="icono-check"/>
                        <ui:Label name="lbl-proxima" text="Próxima: Fauna del Maule" class="texto-gris"/>
                    </ui:VisualElement>
                    <ui:Label text="+60 pts AR" class="texto-azul texto-negrita"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Estaciones del Sendero" class="subtitulo"/>
            <ui:VisualElement name="estaciones"/>
            <ui:VisualElement class="tip">
                <ui:Label text="Tip de Explorador" class="tip__titulo"/>
                <ui:Label text="Escanea los 5 códigos QR físicos distribuidos en las estaciones del sendero para obtener tu insignia digital oficial Colbún." class="tip__texto"/>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement picking-mode="Ignore" class="flotante">
            <ui:Button name="btn-escanear" text="Escanear QR" class="boton-escanear"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="pantalla-escaner" class="pantalla escaner">
        <ui:VisualElement class="escaner__cabecera">
            <ui:Button name="btn-volver" text="Volver" class="escaner__volver"/>
            <ui:Label text="VISOR AR ACTIVO" class="escaner__estado"/>
        </ui:VisualElement>
        <ui:Label text="Apunta la cámara al marcador QR de la estación" class="escaner__instruccion"/>
        <ui:VisualElement picking-mode="Ignore" class="escaner__centro">
            <ui:VisualElement picking-mode="Ignore" class="escaner__marco"/>
        </ui:VisualElement>
        <ui:Label name="lbl-mensaje" picking-mode="Ignore" class="escaner__mensaje"/>
        <ui:Button name="btn-simular" text="Ingresar Código" class="escaner__simular"/>
    </ui:VisualElement>
    <ui:VisualElement name="pantalla-encuesta" class="pantalla pasaporte" style="display: none;">
        <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" class="encuesta-scroll">
            <ui:Label text="Encuesta del visitante" class="titulo-grande encuesta-margen"/>
            <ui:Label text="Es anónima y toma menos de un minuto." class="texto-gris encuesta-margen"/>
            <ui:VisualElement class="tarjeta">
                <ui:Label text="¿De dónde nos visitas?" class="texto-fuerte"/>
                <ui:VisualElement name="ch-origen" class="chips"/>
            </ui:VisualElement>
            <ui:VisualElement class="tarjeta">
                <ui:Label text="Tu rango de edad" class="texto-fuerte"/>
                <ui:VisualElement name="ch-edad" class="chips"/>
            </ui:VisualElement>
            <ui:VisualElement class="tarjeta">
                <ui:Label text="¿Cómo fue tu experiencia? (1 a 5)" class="texto-fuerte"/>
                <ui:VisualElement name="ch-nota" class="chips"/>
            </ui:VisualElement>
            <ui:VisualElement class="tarjeta">
                <ui:Label text="Comentarios (opcional)" class="texto-fuerte"/>
                <ui:TextField name="tf-comentario" multiline="true" max-length="300" class="encuesta-texto"/>
            </ui:VisualElement>
            <ui:Label name="lbl-encuesta-mensaje" class="texto-gris encuesta-margen"/>
            <ui:Button name="btn-enviar-encuesta" text="Enviar encuesta" class="boton-escanear encuesta-enviar"/>
        </ui:ScrollView>
    </ui:VisualElement>
    <ui:VisualElement name="pantalla-kiba" class="pantalla pasaporte" style="display: none;">
        <ui:Label text="Kiba" class="titulo-grande" style="margin: 80px 50px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="barra-nav" class="barra-nav">
        <ui:Button name="btn-nav-pasaporte" class="nav-btn nav-btn--activo">
            <ui:VisualElement class="nav-icono icono-pasaporte"/>
            <ui:Label text="Pasaporte" class="nav-texto"/>
        </ui:Button>
        <ui:Button name="btn-nav-camara" class="nav-btn nav-btn-camara">
            <ui:VisualElement class="nav-icono icono-camara-ar"/>
            <ui:Label text="Cámara AR" class="nav-texto"/>
        </ui:Button>
        <ui:Button name="btn-nav-kiba" class="nav-btn">
            <ui:VisualElement class="nav-icono icono-klba"/>
            <ui:Label text="Kiba" class="nav-texto"/>
        </ui:Button>
        <ui:Button name="btn-nav-encuesta" class="nav-btn">
            <ui:VisualElement class="nav-icono icono-encuesta"/>
            <ui:Label text="Encuesta" class="nav-texto"/>
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="pantalla-detalle" style="flex-grow: 1; width: 100%; height: 100%; display: none; background-color: rgb(229, 229, 229);">
        <ui:Label text="Label" name="TXT_Titulo"/>
        <ui:Label text="Label" name="TXT_Descripcion"/>
    </ui:VisualElement>
</ui:UXML>
